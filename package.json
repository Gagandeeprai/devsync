{
  "name": "devsync",
  "version": "1.0.0",
  "description": "DevSync — Full-Stack Developer Collaboration Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "prisma:generate": "npm run --prefix server prisma:generate",
    "prisma:migrate": "npm run --prefix server prisma:migrate",
    "prisma:seed": "npm run --prefix server prisma:seed",
    "db:push": "npm run --prefix server db:push",
    "server": "npm run --prefix server dev",
    "client": "npm run --prefix client dev",
    "build:server": "npm run --prefix server build",
    "build:client": "npm run --prefix client build",
    "build": "npm run build:server && npm run build:client"
  }
}

