PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://devsync:devsync@127.0.0.1:5432/devsync?schema=public"
JWT_SECRET="replace-with-a-secure-secret-token"
CLIENT_URL="http://localhost:5173"

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# GitHub Integration (OAuth & Webhooks)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL="http://localhost:5000/api/github/callback"
GITHUB_WEBHOOK_SECRET="devsync-github-webhook-secret"
GITHUB_TOKEN_ENCRYPTION_KEY="devsync-token-secret-key-32-bytes-secure"
